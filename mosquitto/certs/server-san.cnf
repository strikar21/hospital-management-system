[req]
default_bits = 4096
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = v3_req

[dn]
C=IN
ST=Telangana
L=Hyderabad
O=Symbiot
OU=SymHMS Development
CN=localhost

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = hospital-mosquitto
IP.1 = 127.0.0.1
IP.2 = 192.168.0.113
