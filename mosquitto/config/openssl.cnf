# OpenSSL Configuration for Mosquitto
# This config disables TLS 1.3 and forces TLS 1.2 only
# ESP32 does not support TLS 1.3

openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
# Disable TLS 1.3, allow only TLS 1.2 and below
MinProtocol = TLSv1.2
MaxProtocol = TLSv1.2

# Allow common ciphers for TLS 1.2
CipherString = DEFAULT:@SECLEVEL=1
