# Hospital Management System - Production Environment Configuration
# Generated: 2024-09-24

# Environment
ENV=production
NODE_ENV=production

# Database Configuration
DB_NAME=hospitaldb
DB_USER=hospital_user
DB_PASSWORD=hospital_prod_2024_CHANGE_ME
DB_HOST=postgres
DB_PORT=5432

# TimescaleDB Configuration
TIMESCALE_DB=hospital_timeseries
TIMESCALE_USER=timescale_user
TIMESCALE_PASSWORD=timescale_prod_2024_CHANGE_ME
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432

# Security Configuration
JWT_SECRET=hospital_jwt_production_secret_2024_CHANGE_ME
ENCRYPTION_KEY=hospital_encryption_key_prod_2024_CHANGE_ME
SESSION_SECRET=hospital_session_secret_prod_2024_CHANGE_ME

# Redis Configuration
REDIS_PASSWORD=redis_prod_2024_CHANGE_ME
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
API_BASE_URL=https://api.hospital.yourdomain.com
WEBSOCKET_URL=wss://api.hospital.yourdomain.com
CORS_ORIGINS=https://hospital.yourdomain.com,https://www.hospital.yourdomain.com

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key
SSL_REDIRECT=true

# Monitoring Configuration
GRAFANA_PASSWORD=grafana_admin_2024_CHANGE_ME
PROMETHEUS_RETENTION=200h

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/hospital.log
ERROR_LOG_FILE=/app/logs/error.log

# Performance Configuration
MAX_WORKERS=4
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=65
CLIENT_MAX_BODY_SIZE=10M

# Medical Compliance
HIPAA_AUDIT_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years as per HIPAA
DATA_ENCRYPTION_AT_REST=true
TLS_VERSION_MIN=1.2

# Email Configuration (for alerts)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=hospital-alerts@yourdomain.com
SMTP_PASSWORD=smtp_password_CHANGE_ME
ALERT_EMAIL_TO=admin@yourdomain.com

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=90
S3_BACKUP_BUCKET=hospital-backups-prod
AWS_ACCESS_KEY_ID=your_aws_key_CHANGE_ME
AWS_SECRET_ACCESS_KEY=your_aws_secret_CHANGE_ME
AWS_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600  # 1 hour

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Feature Flags
ESP32_INTEGRATION_ENABLED=true
REAL_TIME_MONITORING=true
ADVANCED_ANALYTICS=true
MOBILE_APP_SUPPORT=true

# Development Overrides (set to false in production)
DEBUG_MODE=false
MOCK_DATA_ENABLED=false
TEST_ENDPOINTS_ENABLED=false