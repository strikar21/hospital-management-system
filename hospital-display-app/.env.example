# Hospital Management System - Environment Configuration
# Copy this file to .env.local and configure for your environment

# ==============================================
# BACKEND CONFIGURATION
# ==============================================

# Backend API Base URL (for production deployment)
REACT_APP_BACKEND_URL=https://your-hospital-backend.com

# WebSocket URL for real-time updates
REACT_APP_WS_URL=wss://your-hospital-backend.com

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# Secret key for request signing (REQUIRED for production)
# Generate a strong random key: openssl rand -base64 32
REACT_APP_HOSPITAL_SECRET_KEY=your-super-secret-key-here-change-in-production

# ==============================================
# MEDICAL COMPLIANCE
# ==============================================

# Environment designation for audit logs
REACT_APP_ENVIRONMENT=development

# Institution identifier for HIPAA compliance
REACT_APP_INSTITUTION_ID=your-hospital-id

# ==============================================
# OPTIONAL FEATURES
# ==============================================

# Enable debug logging for development
REACT_APP_DEBUG_LOGGING=true

# Enable offline mode features
REACT_APP_ENABLE_OFFLINE=true

# Enable advanced monitoring features
REACT_APP_ENABLE_ADVANCED_MONITORING=true

# Default language (ISO 639-1 code)
REACT_APP_DEFAULT_LANGUAGE=en

# ==============================================
# DEVELOPMENT ONLY
# ==============================================

# Skip authentication in development (NOT for production)
REACT_APP_SKIP_AUTH=false

# Mock data mode for testing without backend
REACT_APP_MOCK_MODE=false