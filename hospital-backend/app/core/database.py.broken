@asynccontextmanager
async def get_timescale_connection():
    """Get TimescaleDB connection for vitals data"""
    global timescale_pool
    
    if timescale_pool is None:
        # Create TimescaleDB connection pool
        timescale_pool = await asyncpg.create_pool(
            host=settings.timescaledb_host,
            port=settings.timescaledb_port,
            database=settings.timescaledb_name,
            user=settings.timescaledb_user,
            password=settings.timescaledb_password,
            min_size=5,
            max_size=20,
            command_timeout=30
        )
        logger.info("✅ TimescaleDB connection pool created for vitals")
    
    async with timescale_pool.acquire() as conn:
        yield conn

async def create_timescale_tables():
    """Create TimescaleDB hypertables for vitals data"""
    
    # TimescaleDB SQL for vitals hypertable
    timescale_sql = """
    -- Enable TimescaleDB extension
    CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE;
    
    -- Vitals time-series table
    CREATE TABLE IF NOT EXISTS vitals_timeseries (
        time TIMESTAMPTZ NOT NULL DEFAULT NOW(),
        patientId TEXT NOT NULL,
        deviceId TEXT NOT NULL,
        vitalType TEXT NOT NULL, -- 'heartRate', 'bloodPressure', 'temperature', etc.
        value DOUBLE PRECISION NOT NULL,
        unit TEXT NOT NULL, -- 'bpm', 'mmHg', '°F', '%', etc.
        quality INTEGER DEFAULT 100, -- Signal quality 0-100
        rawData JSONB, -- Store raw sensor data
        metadata JSONB -- Additional metadata like device calibration
    );
    
    -- Create hypertable (only if not already created)
    SELECT create_hypertable('vitals_timeseries', 'time', 
                            chunk_time_interval => INTERVAL '1 hour',
                            if_not_exists => TRUE);
    
    -- Patient alerts time-series table
    CREATE TABLE IF NOT EXISTS patient_alerts (
        time TIMESTAMPTZ NOT NULL DEFAULT NOW(),
        patientId TEXT NOT NULL,
        alertType TEXT NOT NULL, -- 'critical', 'warning', 'info'
        alertCode TEXT NOT NULL, -- 'HR_HIGH', 'BP_LOW', etc.
        message TEXT NOT NULL,
        acknowledged BOOLEAN DEFAULT FALSE,
        acknowledgedBy TEXT,
        acknowledgedAt TIMESTAMPTZ,
        resolved BOOLEAN DEFAULT FALSE,
        resolvedAt TIMESTAMPTZ,
        severity INTEGER DEFAULT 1, -- 1-5 severity scale
        sourceDevice TEXT,
        rawTriggerData JSONB
    );
    
    -- Create hypertable for alerts
    SELECT create_hypertable('patient_alerts', 'time', 
                            chunk_time_interval => INTERVAL '6 hours',
                            if_not_exists => TRUE);
    
    -- Device status time-series table
    CREATE TABLE IF NOT EXISTS device_status (
        time TIMESTAMPTZ NOT NULL DEFAULT NOW(),
        deviceId TEXT NOT NULL,
        batteryLevel INTEGER,
        signalStrength INTEGER,
        temperature DOUBLE PRECISION, -- Device temperature
        lastSync TIMESTAMPTZ,
        status TEXT NOT NULL, -- 'online', 'offline', 'error'
        errorCode TEXT,
        location TEXT,
        metadata JSONB
    );
    
    -- Create hypertable for device status
    SELECT create_hypertable('device_status', 'time', 
                            chunk_time_interval => INTERVAL '2 hours',
                            if_not_exists => TRUE);
    """
    
    # TimescaleDB indexes for optimal query performance
    timescale_indexes_sql = """
    -- Indexes for vitals_timeseries
    CREATE INDEX IF NOT EXISTS idx_vitals_patient_time ON vitals_timeseries (patientId, time DESC);
    CREATE INDEX IF NOT EXISTS idx_vitals_device_time ON vitals_timeseries (deviceId, time DESC);
    CREATE INDEX IF NOT EXISTS idx_vitals_type_time ON vitals_timeseries (vitalType, time DESC);
    CREATE INDEX IF NOT EXISTS idx_vitals_patient_type_time ON vitals_timeseries (patientId, vitalType, time DESC);
    
    -- Indexes for patient_alerts
    CREATE INDEX IF NOT EXISTS idx_alerts_patient_time ON patient_alerts (patientId, time DESC);
    CREATE INDEX IF NOT EXISTS idx_alerts_type_time ON patient_alerts (alertType, time DESC);
    CREATE INDEX IF NOT EXISTS idx_alerts_unacknowledged ON patient_alerts (patientId, acknowledged, time DESC);
    
    -- Indexes for device_status
    CREATE INDEX IF NOT EXISTS idx_device_status_time ON device_status (deviceId, time DESC);
    CREATE INDEX IF NOT EXISTS idx_device_status_online ON device_status (deviceId, status, time DESC);
    """
    
    try:
        async with get_timescale_connection() as conn:
            # PostgreSQL only - removed SQLite support
                logger.info("⚠️ Using SQLite - TimescaleDB features disabled")
                return
            else:
                # Execute TimescaleDB schema
                for statement in timescale_sql.split(';'):
                    if statement.strip():
                        await conn.execute(statement.strip())
                        
                # Execute TimescaleDB indexes
                for statement in timescale_indexes_sql.split(';'):
                    if statement.strip():
                        await conn.execute(statement.strip())
        
        logger.info("✅ TimescaleDB hypertables created successfully")
        
    except Exception as e:
        logger.error(f"❌ Failed to create TimescaleDB tables: {e}")
        raise

async def close_connection_pool():
    """Close database connection pools"""
    global _connection_pool, _timescaledb_pool
    
    if _connection_pool:
        await _connection_pool.close()
        _connection_pool = None
        
    if _timescaledb_pool:
        await _timescaledb_pool.close()
        _timescaledb_pool = None