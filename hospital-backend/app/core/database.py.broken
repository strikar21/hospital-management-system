@asynccontextmanager
async def get_timescale_connection():
    """Get TimescaleDB connection for vitals data"""
    global timescale_pool
    
    if timescale_pool is None:
        # PostgreSQL only - removed SQLite support
        # OLD SQLite code commented out:
        # if settings.use_sqlite:
        #     return None
        # else:
        try:
            timescale_pool = await asyncpg.create_pool(
                settings.timescaledb_url,
                min_size=1,
                max_size=10,
                command_timeout=60
            )
            logger.info("✅ TimescaleDB connection pool created for vitals")
        except Exception as e:
            logger.error(f"❌ Failed to create TimescaleDB pool: {e}")
            raise
    
    async with timescale_pool.acquire() as conn:
        yield conn

async def create_timescale_tables():
    """Create TimescaleDB hypertables for vitals data"""
    
    # TimescaleDB SQL for vitals hypertable
    timescale_sql = """
    -- Enable TimescaleDB extension
    CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE;
    
    -- Create vitals_timeseries table
    CREATE TABLE IF NOT EXISTS vitals_timeseries (
        timestamp TIMESTAMPTZ NOT NULL,
        patient_id TEXT NOT NULL,
        device_id TEXT NOT NULL,
        metric_name TEXT NOT NULL,
        metric_value DOUBLE PRECISION,
        metric_unit TEXT,
        quality_indicator TEXT DEFAULT 'good'
    );
    
    -- Convert to hypertable (only if not already a hypertable)
    SELECT create_hypertable('vitals_timeseries', 'timestamp', if_not_exists => TRUE);
    
    -- Create indexes
    CREATE INDEX IF NOT EXISTS idx_vitals_patient_time ON vitals_timeseries (patient_id, timestamp);
    CREATE INDEX IF NOT EXISTS idx_vitals_device_time ON vitals_timeseries (device_id, timestamp);
    CREATE INDEX IF NOT EXISTS idx_vitals_metric ON vitals_timeseries (patient_id, metric_name, timestamp);
    """
    
    try:
        async with get_timescale_connection() as conn:
            # Execute TimescaleDB creation
            await conn.execute(timescale_sql)
            logger.info("✅ TimescaleDB hypertables created successfully")
            
    except Exception as e:
        logger.error(f"❌ Failed to create TimescaleDB tables: {e}")
        # Don't raise - TimescaleDB is optional
        logger.warning("⚠️ Continuing without TimescaleDB - vitals storage may be limited")

